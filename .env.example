# Copy this file to .env and edit the values below.
# docker-compose reads .env automatically - no extra flags needed.
# .env itself is gitignored, so real secrets never get committed.

# --- Security -----------------------------------------------------------

# Django's cryptographic signing key. MUST be changed to a long random
# value for any deployment reachable by anyone other than you.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=please-change-this-secret-key

# Set to "true" to enable Django's debug error pages (verbose stack
# traces). Never leave this on in production - it leaks source code and
# settings to anyone who can trigger an error.
DJANGO_DEBUG=false

# Comma-separated list of hostnames/IPs this app is allowed to serve.
# "*" allows any host, which is fine on a trusted local LAN behind
# network_mode: host, but should be tightened (e.g. "spook.example.com")
# if the app is exposed more broadly.
DJANGO_ALLOWED_HOSTS=*

# Comma-separated list of origins Django will trust for CSRF-protected
# POST requests (Wake / Remove buttons). Only needed if you put the app
# behind a reverse proxy on a different scheme/host, e.g.:
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://wake.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- General --------------------------------------------------------------

# IANA time zone used for displayed timestamps (e.g. "last woken ... ago")
# and container log timestamps.
TZ=UTC

# Number of gunicorn worker processes.
GUNICORN_WORKERS=3

# --- Optional: auto-create a Django admin user on first boot -------------
# Leave these blank to skip. If set, an admin user is created once
# (idempotent - skipped on later restarts if it already exists) so you
# can log in at /admin/.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com
